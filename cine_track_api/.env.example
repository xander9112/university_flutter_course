# Локальная разработка: pnpm dev (Postgres поднимается через docker compose up -d db)
DATABASE_URL=postgresql://cinetrack:cinetrack@localhost:5434/cinetrack
# Любая длинная случайная строка: openssl rand -base64 32
PAYLOAD_SECRET=change-me
# Необязательно: доступ к TMDB для кнопок импорта в админке —
# API Read Access Token (Bearer) или API Key v3
TMDB_IMPORT_ACCESS_TOKEN=
TMDB_IMPORT_API_KEY=
